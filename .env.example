# ─────────────────────────────────────────────────────────────
# guozhan 环境变量样例 —— 复制为 .env 后填写（.env 已被 .gitignore 排除）
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ★必填：管理端 Bearer 令牌，≥24 字符（服务端用 timingSafeEqual 比较）。
#   生成：openssl rand -hex 24   或   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   不设 ⇒ docker compose 直接拒绝启动（${GUOZHAN_TOKEN:?} 必填语法）
GUOZHAN_TOKEN=

# ★必填：浏览器 Origin 白名单，逗号分隔（防跨站脚本借用玩家浏览器直连后端）。
#   例：https://your-domain.example.com,http://127.0.0.1:8000（本机 SillyTavern 默认端口）
GUOZHAN_ORIGINS=

# LLM（OpenAI 兼容端点）。★LLM_API_KEY 留空必须能跑：
#   留空 = 离线纯确定性模式 —— 规则结算、战斗、经济全部照常，
#   只是没有 AI 战略建议与 LLM 叙事（自动降级为模板叙事）。
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 服务监听。Docker 内保持默认；裸跑（scripts/start.sh）建议 HOST=127.0.0.1 只监听本机，
# 公网暴露交给反代（caddy/nginx）。
PORT=8788
HOST=0.0.0.0

# 数据目录：SQLite 房间库（index.db + rooms/*.db）与备份的根。
# Docker 内固定 /app/data（compose 已把 ./data 挂进去）；裸跑默认 ./data。
# 旧名 DATA_DIR 仍被识别，但新配置请用 GUOZHAN_DATA_DIR。
GUOZHAN_DATA_DIR=./data

# ── 桌游合集（UNO / 斗地主 / 炸弹猫 / 骗子酒馆 / 抢21 / 国战 Web）──
# 独立进程、独立端口，零依赖；酒馆扩展里的“桌游合集”入口默认指向 http://127.0.0.1:8766/
BOARD_GAMES_PORT=8766
BOARD_GAMES_HOST=0.0.0.0
BOARD_GAMES_DEFAULT_GAME=uno
# 桌游合集积分榜目录；留空 = board-games/data（Docker 内自动用 /app/data 命名卷）
# BOARD_GAMES_DATA_DIR=
# 服务端 LLM 玩家位复用上面的 LLM_API_KEY / LLM_MODEL；地址同时认 LLM_API_BASE 与 LLM_BASE_URL。
