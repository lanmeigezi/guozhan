# ── 服务端 ──
CIV_PORT=8790
CIV_HOST=127.0.0.1
# 设置后所有 API 需要 Authorization: Bearer <token>；不设则仅适合本机 / 可信内网
CIV_TOKEN=
# 逗号分隔的 Origin 白名单，酒馆页面地址必须包含
# CIV_ORIGINS=http://127.0.0.1:8000,https://tavern.example.com
CIV_ORIGINS=

# ── 12 个君主席位（按需填写，未填的席位自动降级离线君主）──
# 全局兜底 Key：某席位没配 CIV_MODEL_XX_KEY 时使用
# CIV_API_KEY=
# 席位 1：DeepSeek 示例
# CIV_MODEL_01_KEY=sk-xxxxxxxx
# 席位 2：另一个厂商示例（覆盖默认端点）
# CIV_MODEL_02_KEY=sk-yyyyyyyy
# CIV_MODEL_02_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 其余 CIV_MODEL_03_KEY … CIV_MODEL_12_KEY 同理
# 注意：还要把 config/monarchs.json 里对应席位的 adapter 改成 openai、model 填真实模型 ID

# ── 可选 DM 模型（默认关闭，由 Harness / 人工当 DM）──
# CIV_DM_KEY=
# CIV_DM_MODEL=
# CIV_DM_BASE_URL=

# ── MCP 客户端侧 ──
CIV_API_BASE=http://127.0.0.1:8790
CIV_ROOM_ID=room-1
# 可选：仅当需要通过 MCP 的 civ_set_seats「只写」调整席位时，由人类房主填写房间管理令牌。
# 不填也能正常推演；MCP 没有任何可读取席位分配的工具。
# CIV_ADMIN_TOKEN=adm_xxxxxxxx

# ── Docker / Caddy ──
# CIV_DOMAIN=tavern.example.com
